extends Node

# ==============================================================================================
# 文件功能：全局变量管理模块
# 设计目标：提供游戏全局状态管理和数据记录功能
# 核心逻辑：
#   1. 管理游戏循环次数、当前时间和循环时长
#   2. 记录玩家、子弹和敌人在不同时间点的状态
#   3. 为其他模块提供全局数据访问
# 模块间交互：
#   - 被所有游戏实体模块访问，用于获取和设置全局状态
#   - 被游戏主控制器用于更新游戏时间和循环次数
# 主要变量：
#   - loop: 游戏循环次数
#   - time: 当前游戏时间
#   - wait_time: 每次循环的时长
#   - player_data: 玩家状态记录
#   - bullet_data: 子弹状态记录
#   - enemy_data: 敌人状态记录
# ==============================================================================================

# 游戏核心状态变量
var loop: int = 0          # 游戏循环次数
var time: float = 10.0     # 当前游戏时间（秒）
var wait_time: float = 10.0 # 每次循环的时长（秒）

# 游戏数据记录字典
var player_data: Dictionary = {}  # 玩家状态记录 {loop: {time: {position, flip_h}}}
var bullet_data: Dictionary = {}  # 子弹状态记录 {time: {position, direction}}
var enemy_data: Dictionary = {}   # 敌人状态记录 {loop: {time: {position, flip_h}}}
